<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CAP.AutomatedWorkPriorities</RootNamespace>
    <AssemblyName>CAP_AutomatedWorkPriorities</AssemblyName>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4850" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System">
      <Private>False</Private>
    </Reference>
    <Reference Update="System.Core">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="PostBuildCleanup" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <_ExtraDlls Include="$(OutputPath)*.dll" Exclude="$(OutputPath)CAP_AutomatedWorkPriorities.dll" />
      <_ExtraConfigs Include="$(OutputPath)*.dll.config" />
    </ItemGroup>
    <Delete Files="@(_ExtraDlls);@(_ExtraConfigs)" ContinueOnError="true" />
  </Target>
</Project>
